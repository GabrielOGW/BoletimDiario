# Boletim Audiovisual
#
# O aplicativo de câmera continua 100% client-side: abrir, editar, imprimir e fazer
# backup não dependem de nenhuma variável daqui. O que precisa de configuração é a
# plataforma colaborativa (Fase 2 em diante).
#
# Copie para `.env` e preencha. `.env` está no .gitignore.

# ---------------------------------------------------------------------------
# Banco — Neon Postgres
# ---------------------------------------------------------------------------
# Vindas prontas da integração Neon na Vercel. NUNCA prefixe com NEXT_PUBLIC_:
# são lidas apenas por lib/db/, que carrega `server-only`.

DATABASE_URL=postgresql://user:senha@host.neon.tech/db?sslmode=require

# Conexão sem pooler. Usada por `npm run db:migrate` e pela verificação de schema —
# DDL não deve passar pelo pooler.
DATABASE_URL_UNPOOLED=postgresql://user:senha@host.neon.tech/db?sslmode=require

# ---------------------------------------------------------------------------
# Autenticação — Better Auth
# ---------------------------------------------------------------------------
# Assina os cookies de sessão. Trocá-la desloga todo mundo.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# URL pública da aplicação. Em produção, o domínio real; em desenvolvimento, localhost.
# É a base dos links de redefinição de senha.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# Não há provedor configurado (ADR-028). O fluxo de recuperação de senha está completo,
# mas o link é registrado no log do servidor em vez de enviado. Quando houver domínio
# verificado, o provedor entra em lib/auth/mailer.ts.
